# Exact Vite origin, without a trailing slash.
CLIENT_ORIGIN=http://localhost:5173

# Reserved for future protected endpoints; /health does not need credentials.
SUPABASE_URL=https://your-project.supabase.co

# Optional future secrets. Leave empty for the foundation.
# Never place these values in client/.env or in a VITE_ variable.
SUPABASE_SECRET_KEY=
AI_API_KEY=

