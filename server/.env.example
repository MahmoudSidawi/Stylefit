# Exact Vite origin, without a trailing slash.
CLIENT_ORIGIN=http://localhost:5173

# Required for persistent data. Apply the migrations described in docs/backend.md.
SUPABASE_URL=https://your-project.supabase.co

# Optional future secrets. The current shop endpoints do not use these.
# Never place these values in client/.env or in a VITE_ variable.
SUPABASE_SECRET_KEY=
AI_API_KEY=


# Public key used with the caller JWT so database RLS stays enforced.
SUPABASE_PUBLISHABLE_KEY=

# Groq vision model; key stays on the server.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_TIMEOUT_SECONDS=45
# Disable in production to require a live database for catalogue requests.
